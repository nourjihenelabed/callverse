# Copy this file to a new file named .env and put your own password in it.
# The .env file stays on your computer. It is never uploaded to GitHub.

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/callverse

# Where the AI model runs. Leave this line out to use Ollama on your own computer.
# To use a teammate's computer instead, put its address here:
# OLLAMA_BASE_URL=http://192.168.1.20:11434
